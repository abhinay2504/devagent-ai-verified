# Absolute path is recommended. The default is resolved relative to backend/.
DEVAGENT_WORKSPACE_ROOT=../workspace
DEVAGENT_DATABASE_PATH=./devagent.sqlite3
DEVAGENT_MAX_FILE_BYTES=200000
DEVAGENT_MAX_PATCH_BYTES=150000
DEVAGENT_MAX_TEST_SECONDS=90
DEVAGENT_MAX_REPAIR_ATTEMPTS=3
DEVAGENT_ENABLE_LOCAL_TEST_RUNNER=false
DEVAGENT_DOCKER_IMAGE=devagent-ai-test-runner:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=180
